; GS hang ladder (P65 rank 4, gfx_c3d.c gs_ladder): a point-mode geometry shader that turns each point (v0, its clip
; space position, w = 1) into one green triangle around it. Every output is written whole for every vertex emitted,
; with no branches; the inputs are copied to a temporary first (as sprite.g.pica, P60 D, did).
.gsh point c0

.constf gslp_a(-0.6, -0.6, 0.0, 0.0)
.constf gslp_b(0.6, -0.6, 0.0, 0.0)
.constf gslp_c(0.0, 0.6, 0.0, 0.0)
.constf gslp_green(0.2, 1.0, 0.2, 1.0)
.constf gslp_zero(0.0, 0.0, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.entry gslp_gmain
.proc gslp_gmain
	mov r6, v0

	add r0, gslp_a, r6
	setemit 0
	call gslp_put
	emit

	add r0, gslp_b, r6
	setemit 1
	call gslp_put
	emit

	add r0, gslp_c, r6
	setemit 2, prim
	call gslp_put
	emit

	end
.end

.proc gslp_put
	mov outpos, r0
	mov outtc0, gslp_zero
	mov outtc1, gslp_zero
	mov outclr, gslp_green
.end
