; Vertex shader for the 60 Hz picture (roadmap S8 / engine P39, DKR_INTERP60; gfx_c3d.c gpu_interp.inc): exactly
; transform.v.pica, plus two uniforms. Each frame's GPU commands are run twice (two pictures a retrace apart): the
; first run with ipk.x = 1 moves every position by its draw's delta matrix dlt, which takes where the draw is now
; (the real picture) to where it was half a step earlier (the in-between picture); the second run with ipk.x = 0
; draws it as built. ipk is written only by the short command lists before each run, never through citro3d.
; With ipk.x = 0 the position is exactly mtx * pos, as transform.v.pica gives it.
; Same rules as transform.v.pica: every output written whole, once, no branches.

.entry interp_main

; Uniforms
.fvec eye     ; Stereo 3D: the position moves across (clip y) by eye.x * w + eye.y, as in shader.v.pica
.fvec mtx[4]  ; Rows: each output coordinate's factors for the vertex's x, y, z and 1
.fvec camoff  ; Whole numbers taken off the position first (w = 0), so the matrix's own offset stays small
.fvec texa    ; Texture coordinates: t0 = v1 * texa.xy + texb.xy, t1 = v1 * texa.zw + v2 * texc.zw + texb.zw
.fvec texc
.fvec texb
.fvec fogp    ; Fog factor = clamp(z / w * fogp.x + fogp.y, 0, 1) replaces the colour's alpha when fogp.z = 1
.fvec lightv  ; GPU vertex lighting (fogp.w = 1): grey = clamp(lightv.w + max(n . lightv.xyz, 0), 0, 1), with the
              ; colour's bytes the normal as signed bytes (127 = 1)

.fvec dlt[4]  ; The draw's delta, in the same layout as mtx (each output coordinate's factors for x, y, z and w)
.fvec ipk     ; x: 1 for the in-between picture's run, 0 for the real picture's

; Constants
.constf consts(0.00392156862745098, 0.0, 1.0, 0.0001)
.alias rgba_scale consts.xxxx
.alias zeros consts.yyyy
.alias ones consts.zzzz
.alias tiny consts.wwww
.constf lconsts(127.5, -256.0, 0.0, 0.0)
.alias half_byte lconsts.xxxx
.alias minus_256 lconsts.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

; Inputs
.alias inpos v0
.alias intc0 v1
.alias intc1 v2
.alias inclr v3

.proc interp_main
	; Position
	add r0, -camoff, inpos
	dp4 r1.x, mtx[0], r0
	dp4 r1.y, mtx[1], r0
	dp4 r1.z, mtx[2], r0
	dp4 r1.w, mtx[3], r0

	; The in-between picture: p + ipk.x * (dlt * p - p)
	dp4 r11.x, dlt[0], r1
	dp4 r11.y, dlt[1], r1
	dp4 r11.z, dlt[2], r1
	dp4 r11.w, dlt[3], r1
	add r11, r11, -r1
	mul r11, ipk.xxxx, r11
	add r1, r1, r11

	; Fog factor, from z before the depth clamp below
	max r2, tiny, r1.wwww
	rcp r2, r2.x
	mul r2, r2, r1.zzzz
	mul r2, fogp.xxxx, r2
	add r2, fogp.yyyy, r2
	max r2, zeros, r2
	min r2, ones, r2

	; Colour, the alpha replaced by the fog factor when fogp.z is 1
	mul r3, rgba_scale, inclr

	; Lit colour, used when fogp.w is 1: the normal from the colour's bytes (above 127 are negative)
	slt r8, half_byte, inclr
	mul r8, minus_256, r8
	add r8, inclr, r8
	dp3 r9, lightv, r8
	max r9, zeros, r9
	add r9, lightv.wwww, r9
	min r9, ones, r9
	add r10, r9, -r3
	mul r10, fogp.wwww, r10
	add r3.xyz, r3, r10
	add r4, r2, -r3.wwww
	mul r4, fogp.zzzz, r4
	add r3.w, r3, r4

	; Stereo offset, then the depth clamp (the N64 has no far plane)
	mul r5, eye.xxxx, r1.wwww
	add r5, eye.yyyy, r5
	add r1.y, r1, r5
	min r1.z, zeros, r1

	; Texture coordinates
	mul r6, texa, intc0.xyxy
	mul r7, texc, intc1.xyxy
	add r6, r6, r7
	add r6, texb, r6

	mov outpos, r1
	mov outtc0, r6
	mov outtc1, r6.zwzw
	mov outclr, r3
	end
.end
